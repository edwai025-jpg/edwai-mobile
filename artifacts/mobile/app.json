{
  "expo": {
    "name": "EdwAI",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edwai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryLanguage": "hi",
    "locales": {
      "hi": "./locales/hi.json",
      "en": "./locales/en.json"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edwai.app",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en_IN",
        "NSPhotoLibraryUsageDescription": "EdwAI uses your photo library to set a profile picture.",
        "NSCameraUsageDescription": "EdwAI uses the camera to take a profile picture."
      }
    },
    "android": {
      "package": "com.edwai.app",
      "googleServicesFile": "./firebase/google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#667eea"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "edwai"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "lang": "en-IN"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
