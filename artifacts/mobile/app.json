{
  "expo": {
    "name": "EDUwAI",
    "slug": "eduwai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eduwai",
    "userInterfaceStyle": "light",
    "locales": {
      "hi": "./locales/hi.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edwai.app",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleDevelopmentRegion": "en_IN",
        "NSPhotoLibraryUsageDescription": "EdwAI uses your photo library to set a profile picture.",
        "NSCameraUsageDescription": "EdwAI uses the camera to take a profile picture.",
        "NSMicrophoneUsageDescription": "EDUwAI uses the microphone to transcribe your spoken questions.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "in.eduwai.app",
      "googleServicesFile": "./firebase/google-services.json",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#667eea"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "edwai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "lang": "en-IN"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#667eea"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "eduwai-support"
        }
      ],
      "expo-web-browser",
      "expo-image-picker",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "EDUwAI uses the microphone to transcribe your spoken questions."
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29aa92c7-7051-4c46-b018-87f16a682d83"
      }
    },
    "owner": "innivai-ai-solutions-private-limited"
  }
}
