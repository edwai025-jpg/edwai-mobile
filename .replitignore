# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/artifacts/mobile/generated-artifacts/
/generated-artifacts/

# Development reference files are not part of the running app.
/attached_assets/*
!/attached_assets/*.md
/exports/*
!/exports/*.md
/.canvas/assets/
/footer_scroll.png
